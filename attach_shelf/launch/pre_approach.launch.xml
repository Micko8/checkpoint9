<launch>

  <!-- Declare launch arguments -->
  <arg name="obstacle" default="0.0"/>
  <arg name="degrees" default="0.0"/>
  
  <!-- Include RViz launch file -->
  <include file="$(find-pkg-share attach_shelf)/launch/start_rviz.launch.py">
  </include>
    <!-- Node definition -->
  <node
    pkg="attach_shelf"
    exec="pre_approach_exe"
    name="pre_approach_node"
    output="screen"
    emulate_tty="true">

    <!-- Parameters -->
    <param name="obstacle" value="$(var obstacle)"/>
    <param name="degrees" value="$(var degrees)"/>
  </node>

  <!-- Group with explicit namespace push -->

</launch>